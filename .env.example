# ==============================================================================
# AVTIVE PROFILES: ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.local for local development.
# Add these variables to your Vercel Project Settings for production.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION URL
# ------------------------------------------------------------------------------
# Local: http://localhost:3000
# Production: https://your-domain.vercel.app (or custom domain)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. SUPABASE CONFIGURATION (FROM YOUR NEW SUPABASE PROJECT)
# Find in: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
# Project URL (e.g. https://abcdefghijklm.supabase.co)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Project API Keys -> "anon" "public" key (safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Project API Keys -> "service_role" "secret" key (SERVER ONLY - NEVER SHARE IN PUBLIC)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Optional Storage Buckets override (Defaults to 'profiles' and 'links')
SUPABASE_STORAGE_BUCKET="profiles"
SUPABASE_LINKS_BUCKET="links"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SESSION SECURITY
# ------------------------------------------------------------------------------
# 32+ character random secret for signing secure user session cookies
# Generate via: openssl rand -base64 32
SESSION_SECRET="generate-a-secure-random-secret-key-32-chars-minimum"
AUTH_SECRET="generate-a-secure-random-secret-key-32-chars-minimum"

# ------------------------------------------------------------------------------
# 4. EMAIL PROVIDER CONFIGURATION (OPTIONAL FOR PASSWORD RESET / INVITES)
# ------------------------------------------------------------------------------
# Option A: Resend API (Recommended)
RESEND_API_KEY=""
RESEND_FROM="Avtive Profiles <no-reply@yourdomain.com>"

# Option B: Standard SMTP (Alternative)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="user@example.com"
# SMTP_PASS="password"
# SMTP_FROM="Avtive <no-reply@example.com>"
# SMTP_SECURE="false"
